rules_version = '2';

// BATAILLE — squelette des règles Firestore.
// Principe directeur (cf. section 23-24 du prompt maître) :
// un utilisateur ne doit JAMAIS pouvoir modifier librement son propre
// score, son XP, ou les données d'un autre joueur. Toute écriture
// sensible (score, xp, résultat de partie, classement) passe par les
// Cloud Functions (Admin SDK, qui contourne ces règles côté serveur).
// Ce fichier sera complété et testé à l'étape 3 du plan.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;

      // Création du profil à l'inscription : uniquement ses propres valeurs
      // de départ (xp/level/etc. figés à 0/1, jamais choisis par le client).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.streakCount == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.bestScore == 0;

      // Mise à jour : l'utilisateur peut changer pseudo/avatar,
      // jamais xp/level/streak/stats — réservés aux Cloud Functions.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['xp', 'level', 'streakCount', 'gamesPlayed', 'wins', 'losses', 'bestScore']);

      allow delete: if false;
    }

    match /questions/{questionId} {
      // Pas de lecture directe : les questions sont servies via Cloud Functions
      // pour ne jamais exposer correctAnswer avant une réponse validée.
      allow read: if false;
      allow write: if false;
    }

    match /games/{gameId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // uniquement via Cloud Functions
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false; // uniquement via Cloud Functions
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false; // uniquement via Cloud Functions
    }
  }
}
